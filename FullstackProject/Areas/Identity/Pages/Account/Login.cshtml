@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/css/Login.css">
</head>
<body>
    <!-- Login box Section 06/11/2024 Kanemana Witana -->
    <div class="login-box container py-3" style="width: 450px;">
        <div class="row justify-content-center">
            <!-- Login title Section 06/11/2024 Kanemana Witana -->
            <div class="col-12 text-center mb-4">
                <h1>@ViewData["Title"]</h1>
            </div>

            <!-- External(Google) login Section 06/11/2024 Kanemana Witana -->
            <div class="col-md-6">
                <section>
                    @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                    {
                        <div>
                            <p>
                                There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                    article about setting up this ASP.NET application to support logging in via external services
                                </a>.
                            </p>
                        </div>
                    }
                    else
                    {
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                            <div class="text-center">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-primary mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                        Login with @provider.DisplayName
                                        <img src="~/Images/Google Logo.png" alt="Google logo" width="20" height="20" class="ms-2" />
                                    </button>
                                }
                            </div>
                        </form>
                    }
                </section>
            </div>

            <!-- Divider Section -->
            <div class="col-12 my-4">
                <div class="text-center" style="height: 15px; border-bottom: 1px solid lightgray;">
                    <span class="bg-white px-3" style="font-size: 15px; color:gray;">or</span>
                </div>
            </div>

            <!-- User input details Section 06/11/2024 Kanemana Witana -->
            <div class="col-md-6" style="width: 400px;">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control custom-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control custom-input" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" id="rememberMe" />
                        <label for="rememberMe" class="form-check-label">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                        <a class="hover-link" id="forgot-password" asp-page="./ForgotPassword" style="float: right;">Forgot password?</a>
                    </div>

                    <!-- Login button Section 06/11/2024 Kanemana Witana -->
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg custom-login-btn">Login</button>
                </form>
            </div>
        </div>

        <!-- Register Section 06/11/2024 Kanemana Witana -->
        <div class="text-center mt-4">
            <p>
                New to Shangri? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="hover-link" style="margin-left: 10px;">Join Now</a>
            </p>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

    <!-- Bootstrap Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
</body>
</html>
