ConnectionStrings__DefaultConnection="Server=your-server,1433;Database=your-database;User Id=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=True"
Authentication__Google__ClientId="your-google-client-id"
Authentication__Google__ClientSecret="your-google-client-secret"
