@model IEnumerable<FullStack_Shangri.Models.Developer>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Developers</h1>
@* made Developer page 12/11/24 Karman Dwivedi *@
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactInfo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ContactInfo)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DeveloperId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.DeveloperId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.DeveloperId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination">
    @if (ViewData["TotalPages"] != null)
    {
        int totalPages = (int)ViewData["TotalPages"];
        int currentPage = (int)ViewData["CurrentPage"];

        if (currentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
        }

        for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" class="@(i == currentPage ? "active" : "")">@i</a>
        }

        if (currentPage < totalPages)
        {
            <a asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
        }
    }
</div>

<style>
    .pagination a {
        margin: 0 5px;
        padding: 5px 10px;
        color: blue;
        text-decoration: none;
    }

    .pagination a.active {
        font-weight: bold;
        color: red;
    }
</style>
