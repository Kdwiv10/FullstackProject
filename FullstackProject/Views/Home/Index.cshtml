@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" type="text/css" href="~/css/Frontpage.css">

<head>
    <title>Shangri</title>
    <!-- Styling for the front page -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css">
</head>

<body>
    <!-- Carousel Section 29/10/2024 Karman Dwivedi -->
    <div id="gameCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/Images/Grand theft auto 5.png" class="d-block w-100" alt="Grand Theft Auto V">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Grand Theft Auto V</h5>
                    <p>Experience the ultimate crime world with GTA V Recently added to the Service.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/Images/ea-featured-image-generic-brand-logo.png.adapt.crop16x9.1023w.png" class="d-block w-100" alt="Electronic Arts Sale">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Electronic Arts Sale</h5>
                    <p>Range of EA games on sale.</p>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#gameCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#gameCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Header -->
    <header class="header-text text-center my-4">
        <h1>Video Game Subscriptions for Gamers Around the World</h1>
    </header>

    <!-- Must Owned Games Section 30/10/2024 Karman Dwivedi -->
    <div class="container my-5">
        <h2>Must Owned Games</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            <!-- Card 1 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/Grand theft auto 5.png" class="card-img-top" alt="GTA V">
                    <div class="card-body">
                        <h5 class="card-title">Grand Theft Auto V</h5>
                        <p class="card-text">Price: $29.99 or Play with membership</p>
                    </div>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/AC Mirage.png" class="card-img-top" alt="Assassin Creed Mirage">
                    <div class="card-body">
                        <h5 class="card-title">Assassin Creed Mirage</h5>
                        <p class="card-text">Price: $99.99</p>
                    </div>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/DeadbyDaylight.png" class="card-img-top" alt="Dead by Daylight">
                    <div class="card-body">
                        <h5 class="card-title">Dead by Daylight</h5>
                        <p class="card-text">Price: $9.99</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Game Sales Section -->
    <div class="container my-5">
        <h2>Game Sales for EA</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            <!-- Sale Card 1 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/Starwarsjedi.png" class="card-img-top" alt="Star Wars Jedi: Fallen Order">
                    <div class="card-body">
                        <h5 class="card-title">Star Wars Jedi: Fallen Order</h5>
                        <p class="card-text">Sale Price: $19.99</p>
                    </div>
                </div>
            </div>
            <!-- Sale Card 2 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/fifa-23-button-002a-1658345962881.jpg" class="card-img-top" alt="FIFA 23">
                    <div class="card-body">
                        <h5 class="card-title">FIFA 23</h5>
                        <p class="card-text">Sale Price: $49.99</p>
                    </div>
                </div>
            </div>
            <!-- Sale Card 3 -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/Images/Cover_Art_of_Need_for_Speed_Heat.png" class="card-img-top" alt="Need for Speed Heat">
                    <div class="card-body">
                        <h5 class="card-title">Need for Speed Heat</h5>
                        <p class="card-text">Sale Price: $14.99</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts for Bootstrap Carousel -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

</body>
</html>
