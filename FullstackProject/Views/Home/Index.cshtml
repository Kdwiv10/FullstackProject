@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" type="text/css" href="~/css/Frontpage.css">

<head>
    <title>Video Game Subscription Service</title>
    <!-- Styling for the front page --><link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css">
    
    <!-- Carousel Section 29/10/2024 Karman Dwivedi -->
    <div id="gameCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/Images/Grand theft auto 5.png" class="d-block w-100" alt="Placeholder Game">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Grand Theft Auto V</h5>
                    <p>Experience the ultimate crime world with GTA V Recently added to the Service.</p>
                </div>
            </div>

        </div>
        
        <button class="carousel-control-prev" type="button" data-bs-target="#gameCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#gameCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>

        <!-- Scripts for Bootstrap Carousel -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

        <!--Header-->
        <header class="header-text">
            <h1>Video Game Subscriptions for Gamers Around the world</h1>
            <p>Get access to the latest games with our fast, reliable service.</p>
        </header>

</head>

<body>
    <h1>Must owned games</h1>

    

   
  
</body>

</html>
