@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shangri</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/homepage.css" />
</head>

<body>
    <!-- Carousel Section -->
    <div id="gameCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/2286844-gtalogo-big_61199_screen.jpg" class="d-block w-100" alt="Grand Theft Auto V">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Grand Theft Auto V</h5>
                    <p>Experience the ultimate crime world with GTA V, recently added to the Service.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/EA Background.jpg" class="d-block w-100" alt="Electronic Arts Sale">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Electronic Arts Sale</h5>
                    <p>Range of EA games on sale.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#gameCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#gameCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Header -->
    <header class="header-text text-center my-4">
        <h1 style="color: orange;">Video Game Subscriptions for Gamers Around the World</h1>
    </header>

    <!-- Must Owned Games Section -->
    <div class="container my-5">
        <h2 class="text-center">Must Owned Games</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            <!-- Game Cards -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/1.png" class="card-img-top" alt="GTA V">
                    <div class="card-body">
                        <h5 class="card-title">Grand Theft Auto V</h5>
                        <p class="card-text">Price: $29.99</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/2.png" class="card-img-top" alt="Assassin Creed Mirage">
                    <div class="card-body">
                        <h5 class="card-title">Assassin Creed Mirage</h5>
                        <p class="card-text">Price: $99.99</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/3.png" class="card-img-top" alt="Dead by Daylight">
                    <div class="card-body">
                        <h5 class="card-title">Dead by Daylight</h5>
                        <p class="card-text">Price: $9.99</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Game Sales Section -->
    <div class="container my-5">
        <h2 class="text-center">Game Sales for EA</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            <!-- Sale Cards -->
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/4.png" class="card-img-top" alt="Star Wars Jedi: Fallen Order">
                    <div class="card-body">
                        <h5 class="card-title">Star Wars Jedi: Fallen Order</h5>
                        <p class="card-text">Sale Price: $19.99</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/5.png" class="card-img-top" alt="FIFA 23">
                    <div class="card-body">
                        <h5 class="card-title">FIFA 23</h5>
                        <p class="card-text">Sale Price: $49.99</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 game-card">
                    <img src="~/images/5.png" class="card-img-top" alt="FIFA 23">
                    <div class="card-body">
                        <h5 class="card-title">FIFA 23</h5>
                        <p class="card-text">Sale Price: $49.99</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- YouTube Video Section -->
    <div class="container my-5 text-center">
        <h2 class="mb-4">Watch Our Featured Video</h2>
        <iframe width="1280"
                height="720"
                src="https://www.youtube.com/embed/QdBZY2fkU-0?autoplay=1&loop=1&playlist=QdBZY2fkU-0"
                title="Grand Theft Auto VI Trailer"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen>
        </iframe> 
    </div>

    <!-- Scripts for Bootstrap Carousel -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

</body>
</html>
