@model List<CartItem>

@using System.Globalization
<h2>Shopping Cart</h2>

@if (Model.Count == 0)
{
    <p>Your shopping cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Game Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Image</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.game.Title</td>
                    <td>@item.game.Price</td>
                    <td>@item.Quantity</td>
                    <td>
                        <img src="@Url.Content("~/uploads/" + item.game.ImageFileName)" alt="Game Image" width="150" height="150" />
                    </td>
                    <td>$@(item.game.Price * item.Quantity)</td>
                    <td>
                        <a asp-action="RemoveFromCart" asp-route-id="@item.game.GameId" class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-right">
        <strong>Sub Total: $@ViewBag.OriginalTotal</strong>

        @if (ViewBag.DiscountAmount != null && ViewBag.DiscountAmount > 0)
        {
            <p>Discount: -$@ViewBag.DiscountAmount</p>
        }
        <br />
        <strong>Final Total: $@ViewBag.FinalTotal</strong>
    </div>
    <br />

    <div class="text-right">
        <a class="btn btn-primary btn-sm" href="@Url.Action("ClearCart", "ShoppingCart")">Clear Cart</a>
        <a asp-controller="Game" asp-action="Index" class="btn btn-primary btn-sm">Continue shopping</a>
    </div>
    <br />
    
    <input id="GrandTotal" type="hidden" value="@ViewBag.FinalTotal" />
    <div id="paypal-button-container"></div>
    <div id="paypal-error" class="alert alert-danger mt-3 d-none" role="alert"></div>
    <script src="https://www.paypal.com/sdk/js?client-id=ATNwtOFAgffDhMfTE8dGXlau9W8Gv82HLENDNmAfobf55lKFzR1u48MWIaTOK4s6V0Rancd7L8HJSox3"></script>
    <script>
        function showPayPalError(error) {
            console.error('PayPal checkout error:', error);

            const detail = error?.details?.[0];
            const message = detail?.description || error?.message || 'PayPal could not complete the payment. Please try again.';
            const errorContainer = document.getElementById('paypal-error');

            errorContainer.textContent = message;
            errorContainer.classList.remove('d-none');
        }

        paypal.Buttons({
            createOrder: function (data, actions) {
                const total = Number.parseFloat(document.getElementById("GrandTotal").value);

                if (!Number.isFinite(total) || total <= 0) {
                    showPayPalError(new Error('Your cart total must be greater than zero.'));
                    return Promise.reject(new Error('Invalid cart total.'));
                }

                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            currency_code: 'USD',
                            value: total.toFixed(2)
                        }
                    }]
                });
            },
            onApprove: function (data, actions) {
                return actions.order.capture().then(function (details) {
                    if (details.status !== 'COMPLETED') {
                        throw new Error('PayPal returned payment status: ' + details.status);
                    }

                    window.location.assign('@Url.Action("Success", "ShoppingCart")');
                }).catch(function (error) {
                    showPayPalError(error);
                });
            },
            onError: function (error) {
                showPayPalError(error);
            }
        }).render('#paypal-button-container');


    </script>
}
