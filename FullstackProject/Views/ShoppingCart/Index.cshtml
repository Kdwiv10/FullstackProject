@model List<FullstackProject.Controllers.CartItem>

@using System.Globalization

@if (Model.Count == 0)
{
    <p>Your shopping cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Game Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Image</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>

                    <td>
                        $@item.Price
                    </td>

                    <td>
                        @item.Quantity
                    </td>

                    <td>
                        <img src="@Url.Content("~/uploads/" + item.ImageFileName)"
                             alt="@item.Title"
                             width="150"
                             height="150" />
                    </td>

                    <td>
                        $@(item.Price * item.Quantity)
                    </td>

                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("RemoveFromCart", "ShoppingCart", new { id = item.GameId })">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-right">
        <strong>
            Sub Total: $@ViewBag.OriginalTotal
        </strong>

        @if (ViewBag.DiscountAmount != null &&
             ViewBag.DiscountAmount > 0)
        {
            <p>
                Discount: -$@ViewBag.DiscountAmount
            </p>
        }

        <br />

        <strong>
            Final Total: $@ViewBag.FinalTotal
        </strong>
    </div>

    <br />

    <div class="text-right">
        <a class="btn btn-primary btn-sm"
           href="@Url.Action("ClearCart", "ShoppingCart")">
            Clear Cart
        </a>

        <a asp-controller="Games"
           asp-action="Index"
           class="btn btn-primary btn-sm">
            Continue shopping
        </a>
    </div>

    <br />

    <input id="GrandTotal"
           type="hidden"
           value="@ViewBag.FinalTotal" />

    <div id="paypal-button-container"></div>

    <script src="https://www.paypal.com/sdk/js?client-id=ATNwtOFAgffDhMfTE8dGXlau9W8Gv82HLENDNmAfobf55lKFzR1u48MWIaTOK4s6V0Rancd7L8HJSox3"></script>

    <script>
        paypal.Buttons({
            createOrder: function (data, actions) {
                var grandTotal = parseFloat(
                    document.getElementById("GrandTotal").value
                ).toFixed(2);

                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            value: grandTotal
                        }
                    }]
                });
            },

            onApprove: function (data, actions) {
                return actions.order.capture().then(function (details) {

                    alert(
                        'Transaction completed by ' +
                        details.payer.name.given_name
                    );

                    window.location.href =
                        '/ShoppingCart/Success';
                });
            }
        }).render('#paypal-button-container');
    </script>
}