@model IEnumerable<FullstackProject.Model.Developer>

@{
    ViewData["Title"] = "Developer Contact Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Developer Contact Details</h1>

<!-- Create New Developer Button (visible only to Admins) -->
<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">Create New</a>
    }
</p>

<!--made a auto suggestion form 8/11/2024 Karman Dwivedi-->
<!-- Search Form with Ajax for Suggestions -->
<form id="searchForm" action="/Developers/Index" method="get" class="mb-3">
    <p>Search Developer</p>
    <input type="text" id="searchString" name="searchString" style="width:180px" onkeyup="AjaxRequest(this.value)" />
    <input type="submit" value="Search" class="btn btn-primary" />
    <div id="AutoSuggestContainer" style="position:absolute; display:none; z-index:100;"></div>
</form>

<script type="text/javascript">
    function AjaxRequest(searchString) {
        if (searchString.length < 3) {
            document.getElementById("AutoSuggestContainer").style.display = "none";
            return;
        }

        var xmlhttp = new XMLHttpRequest();
        var url = "/Developers/IndexAjax?searchString=" + encodeURIComponent(searchString);  // Added encodeURIComponent for safer URL handling
        xmlhttp.open("GET", url, true);  // Set to asynchronous
        xmlhttp.onreadystatechange = function () {
            if (xmlhttp.readyState === 4 && xmlhttp.status === 200) {
                var response = JSON.parse(xmlhttp.responseText);
                var suggestions = "";

                for (var i = 0; i < response.length; i++) {
                    suggestions +=
                        "<input type='button' value='" + response[i].Name + " (" + response[i].Email + ")' " +
                        "onclick='document.getElementById(\"searchString\").value = \"" + response[i].Name + "\"; " +
                        "document.getElementById(\"searchForm\").submit();' " +
                        "style='width:280px;' />" +
                        "<br/>";
                }

                var container = document.getElementById("AutoSuggestContainer");
                container.innerHTML = suggestions;

                // Show container only if there are suggestions
                container.style.display = suggestions ? "block" : "none";
            }
        };
        xmlhttp.send();
    }
</script>


<!-- Developer Table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Name)</th>
            <th>@Html.DisplayNameFor(model => model.First().Email)</th>
            <th>@Html.DisplayNameFor(model => model.First().ContactInfo)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.ContactInfo)</td>
                <td>
                    @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.DeveloperId">Edit</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.DeveloperId">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.DeveloperId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
