@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

<h2>Roles</h2>

<a asp-action="CreateRole" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Role</a>
@* Created Admin Panel 15/11/24 Karman Dwivedi *@
<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <td>Role Name</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
                    <a asp-action="DeleteRole" asp-route-id="@role.Id" class="btn btn-danger"><i class="fas fa-trash-alt"></i> Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>