@model IEnumerable<FullStack_Shangri.Models.Memberships>

@{
    ViewData["Title"] = "Memberships";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@* Made memberships page 17/11/24 Kanemana Witana *@
<h1>Memberships</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a> 
    </p>
}

<div class="text-black">
    @if (ViewData["MembershipTimeLeft"] != null)
    {
        <span style="font-weight: bold;">Current Membership Expires In: @ViewData["MembershipTimeLeft"] days</span>
    }else
    {
        <span style="font-weight: bold;">No Current Membership</span>
    }
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiscountRate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiscountRate)
            </td>
                @if (User.IsInRole("Admin"))
                {
            <td>
                <a asp-action="Edit" asp-route-id="@item.MembershipId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MembershipId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MembershipId">Delete</a>
            </td>
                }

        </tr>
}
    </tbody>
</table>
