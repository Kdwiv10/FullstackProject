@model IEnumerable<FullStack_Shangri.Models.Genre>
@{
    ViewData["Title"] = "Game Index";
}

<h1>Games</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Developer"))
{
    <p>
        <a asp-action="Create">Add New Game</a>
    </p>
}

<!-- Search Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control search-input" placeholder="Search games by title or description" value="@ViewData["searchString"]" />
        <button class="btn btn-primary search-button" type="submit">Search</button>
    </div>
</form>

<!-- Tabs for each Genre and All Games -->
<ul class="nav nav-tabs" id="genreTabs" role="tablist">
    <!-- All Games Tab -->
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.FirstOrDefault()?.Id == null ? "active" : "")" id="tab-all-games" data-bs-toggle="tab" data-bs-target="#all-games" type="button" role="tab" aria-controls="all-games" aria-selected="@(Model.FirstOrDefault()?.Id == null ? "true" : "false")">
            All Games
        </button>
    </li>

    <!-- Genre Tabs -->
    @foreach (var genre in Model)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(genre.Id == Model.First().Id ? "active" : "")" id="tab-@genre.Id" data-bs-toggle="tab" data-bs-target="#genre-@genre.Id" type="button" role="tab" aria-controls="genre-@genre.Id" aria-selected="@(genre.Id == Model.First().Id ? "true" : "false")">
                @genre.Name
            </button>
        </li>
    }
</ul>

<!-- Tab content for All Games and Each Genre -->
<div class="tab-content" id="genreTabsContent">
    <!-- All Games Tab Content -->
    <div class="tab-pane fade @(Model.FirstOrDefault()?.Id == null ? "show active" : "")" id="all-games" role="tabpanel" aria-labelledby="tab-all-games">
        <div class="row mt-3">
            @if (Model.SelectMany(c => c.Games).Any())
            {
                @foreach (var game in Model.SelectMany(c => c.Games))
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <img src="@Url.Content("~/uploads/" + game.ImageFileName)" class="card-img-top" alt="@game.Title" style="height: 200px; object-fit: cover;" />
                            <div class="card-body">
                                <h5 class="card-title">@game.Title</h5>
                                <p class="card-text">@game.Description</p>
                                <p class="card-text">
                                    <strong>Price:</strong> $@game.Price <br />
                                    <strong>Release Date:</strong> @game.ReleaseDate <br />
                                    <strong>Genre:</strong> @game.Genre.Name <br />
                                    <strong>Stock:</strong> @game.Stock
                                </p>
                            </div>
                            <div class="card-footer">
                                @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
                                {
                                    <!-- Action Buttons -->
                                    <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="Details" asp-route-id="@game.GameId" class="btn btn-info btn-sm">Details</a>
                                    <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-danger btn-sm">Delete</a>
                                }
                                <!-- Add to Cart button - disabled if stock is zero -->
                                @if (game.Stock > 0)
                                {
                                    <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@game.GameId" class="btn btn-primary btn-sm">Add To Cart</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" disabled>Out of Stock</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No game available.</p>
            }
        </div>
    </div>

    <!-- Tab Content for Each Genre -->
    @foreach (var genre in Model)
    {
        <div class="tab-pane fade @(genre.Id == Model.First().Id ? "show active" : "")" id="genre-@genre.Id" role="tabpanel" aria-labelledby="tab-@genre.Id">
            <div class="row mt-3">
                @if (genre.Games.Any())
                {
                    @foreach (var game in genre.Games)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <img src="@Url.Content("~/uploads/" + game.ImageFileName)" class="card-img-top" alt="@game.Title" style="height: 200px; object-fit: cover;" />
                                <div class="card-body">
                                    <h5 class="card-title">@game.Title</h5>
                                    <p class="card-text">@game.Description</p>
                                    <p class="card-text">
                                        <strong>Price:</strong> $@game.Price <br />
                                        <strong>Release Date:</strong> @game.ReleaseDate <br />
                                        <strong>Genre:</strong> @game.Genre.Name <br />
                                        <strong>Stock:</strong> @game.Stock
                                    </p>
                                </div>
                                <div class="card-footer">
                                    @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
                                    {
                                        <!-- Action Buttons -->
                                        <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-warning btn-sm">Edit</a>
                                        <a asp-action="Details" asp-route-id="@game.GameId" class="btn btn-info btn-sm">Details</a>
                                        <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-danger btn-sm">Delete</a>
                                    }
                                    <!-- Add to Cart button - disabled if stock is zero -->
                                    @if (game.Stock > 0)
                                    {
                                        <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@game.GameId" class="btn btn-primary btn-sm">Add To Cart</a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>Out of Stock</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No game available in this genre.</p>
                }
            </div>
        </div>
    }
</div>
