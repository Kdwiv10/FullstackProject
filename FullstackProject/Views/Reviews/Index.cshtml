@model IEnumerable<FullstackProject.Model.Review>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/css/Reviews.css">

<h1>Reviews</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Comments)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Game)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Rating)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Comments)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Game.Title)  <!-- Display game title instead of GameId -->
                </td>
                
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.ReviewId">Edit</a>
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.ReviewId">Delete</a>
                        <text> | </text>
                    }
                    <a asp-action="Details" asp-route-id="@item.ReviewId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
