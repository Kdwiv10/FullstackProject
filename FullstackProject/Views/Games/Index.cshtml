@model IEnumerable<FullstackProject.Model.Game>

@{
    ViewData["Title"] = "Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Games</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Developer.DeveloperId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().DeveloperName)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Developer.DeveloperId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DeveloperName)
                </td>
                <td>
                    <!-- Action Links -->
                    @if (User.IsInRole("Developer") || User.IsInRole("Admin")) // Show Edit link for Developers and Admins
                    {
                        <a asp-action="Edit" asp-route-id="@item.GameId">Edit</a>
                    }
                    @if (User.IsInRole("Admin")) // Show Delete link only for Admins
                    {
                        <a asp-action="Delete" asp-route-id="@item.GameId">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.GameId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
