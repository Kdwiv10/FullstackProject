@model IEnumerable<FullstackProject.Model.Game>

@{
    ViewData["Title"] = "Game Index";
}

<h1>Games</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">Create New</a>
    }
</p>

<!-- Tabs for each Genre and All Games -->
<ul class="nav nav-tabs" id="genreTabs" role="tablist">
    <!-- All Games Tab -->
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-all-games" data-bs-toggle="tab" data-bs-target="#all-games" type="button" role="tab" aria-controls="all-games" aria-selected="true">
            All Games
        </button>
    </li>

    <!-- Genre Tabs -->
    @foreach (var genre in Model.Select(g => g.Genre).Distinct())
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-@genre" data-bs-toggle="tab" data-bs-target="#genre-@genre" type="button" role="tab" aria-controls="genre-@genre" aria-selected="false">
                @genre
            </button>
        </li>
    }
</ul>
<!--Made new display for games 8/11/2024 Karman Dwivedi-->
<!-- Tab content for All Games and Each Genre -->
<div class="tab-content" id="genreTabsContent">
    <!-- All Games Tab Content -->
    <div class="tab-pane fade show active" id="all-games" role="tabpanel" aria-labelledby="tab-all-games">
        <div class="row mt-3">
            @if (Model.Any())
            {
                @foreach (var game in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            
                            <!-- Display Game Image 10/11/24 Karman Dwivedi -->
                            <img src="@Url.Content(game.ImageFileName)" class="card-img-top" alt="@game.Title" style="height: 200px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />

                            <div class="card-body">
                                <h5 class="card-title">@game.Title</h5>
                                <p class="card-text">@game.Description</p>
                                <p class="card-text">
                                    <strong>Price:</strong> $@game.Price<br />
                                    <strong>Release Date:</strong> @game.ReleaseDate <br />
                                    <strong>Genre:</strong> @game.Genre <br />
                                    <strong>Developer:</strong> @game.DeveloperName
                                </p>
                            </div>
                            <div class="card-footer">
                                <!-- Action Buttons -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-danger btn-sm">Delete</a>
                                }
                                <a asp-action="Details" asp-route-id="@game.GameId" class="btn btn-info btn-sm">Details</a>
                                <a asp-controller="ShoppingCart" asp-action="BuyNow" asp-route-id="@game.GameId" class="btn btn-success btn-sm">Buy Now</a>
                                <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@game.GameId" class="btn btn-outline-primary btn-sm">Add to Cart</a>
                            </div>
                        </div>
                    </div>

                }
            }
            else
            {
                <p class="text-muted">No games available.</p>
            }
        </div>
    </div>

    <!-- Tab Content for Each Genre -->
    @foreach (var genre in Model.Select(g => g.Genre).Distinct())
    {
        <div class="tab-pane fade" id="genre-@genre" role="tabpanel" aria-labelledby="tab-@genre">
            <div class="row mt-3">
                @if (Model.Where(g => g.Genre == genre).Any())
                {
                    @foreach (var game in Model.Where(g => g.Genre == genre))
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <img src="@Url.Content("~/uploads/" + game.GameId + ".jpg")" class="card-img-top" alt="Game Image" style="height: 200px; object-fit: cover;" />
                                <div class="card-body">
                                    <h5 class="card-title">@game.Title</h5>
                                    <p class="card-text">@game.Description</p>
                                    <p class="card-text">
                                        <strong>Price:</strong> $@game.Price<br />
                                        <strong>Release Date:</strong> @game.ReleaseDate <br />
                                        <strong>Genre:</strong> @game.Genre <br />
                                        <strong>Developer:</strong> @game.DeveloperName
                                    </p>
                                </div>
                                <div class="card-footer">
                                    <!-- Action Buttons -->
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-warning btn-sm">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-danger btn-sm">Delete</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@game.GameId" class="btn btn-info btn-sm">Details</a>
                                    <a asp-controller="ShoppingCart" asp-action="BuyNow" asp-route-id="@game.GameId" class="btn btn-success btn-sm">Buy Now</a>
                                    <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@game.GameId" class="btn btn-outline-primary btn-sm">Add to Cart</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No games available in this genre.</p>
                }
            </div>
        </div>
    }
</div>
