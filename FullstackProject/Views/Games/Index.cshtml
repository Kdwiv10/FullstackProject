@model IEnumerable<FullstackProject.Model.Game>

@{
    ViewData["Title"] = "Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Games</h1>


@if (User.IsInRole("Administrator"))
{
    <p>
        <a asp-action="Create">Add New Game</a>
    </p>
}

<div class="row">
@foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <!-- Display the actual Game image -->
                <img src="@item.ImageFileName" class="card-img-top" alt="Game Image" />

                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="card-text"><small class="text-muted">Release Date: @string.Format(("{0:MM/dd/yyyy}"), item.ReleaseDate)</small></p>
                    <p class="card-text"><strong>Price:</strong> @item.Price</p>
                    <p class="card-text"><strong>Genre:</strong> @item.Genre</p>
                    <p class="card-text"><strong>DeveloperID:</strong> @item.DeveloperId</p>
                    <p class="card-text"><strong>Developer Name:</strong> @item.DeveloperName</p>
                </div>

                <div class="card-footer">
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.GameId" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.GameId" class="btn btn-danger btn-sm">Delete</a>
                    }

                    <a asp-action="Details" asp-route-id="@item.GameId" class="btn btn-info btn-sm">Details</a>
                </div>
            </div>
        </div>
}
</div>

